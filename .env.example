# TELEGRAM CONFIGURATION
# Obtain API ID & API HASH from https://my.telegram.org (under API development tools)
TELEGRAM_API_ID="12345678"
TELEGRAM_API_HASH="0123456789abcdef0123456789abcdef"

# AES-256-GCM Session Encryption Key (32-byte hex or 64 character hex string)
TELEGRAM_SESSION_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Primary admin email (for access to admin settings and media manager)
ADMIN_EMAIL="admin@vidframe.ai"

# Server session or cookie secret
ADMIN_SECRET_KEY="super-secret-admin-session-signing-token"

# Public App Origin
APP_URL="https://vidframe.ai.studio"

# Optional Gemini API Key
GEMINI_API_KEY="MY_GEMINI_API_KEY"
